# Supabase — публичная конфигурация (уходит в бандл фронта и админки).
# Publishable key — новый аналог старого anon key. Имя переменной оставлено
# прежним (VITE_SUPABASE_ANON_KEY), потому что так оно называется в коде.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ВНИМАНИЕ: secret key — только для сервера / Supabase CLI / Edge Functions.
# Префикса VITE_ здесь нет намеренно: Vite подставляет в сборку только
# переменные с префиксом VITE_, поэтому этот ключ физически не может
# попасть в браузерный бандл. Не добавляйте сюда VITE_.
SUPABASE_SECRET_KEY=
